style.css
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #222;
}

.dashboard {
    max-width: 1100px;
    margin: auto;
    padding: 40px 25px;
}

h1 {
    font-size: 36px;
    margin-bottom: 10px;
}

.dashboard > p {
    color: #666;
    margin-bottom: 30px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
}

.card h3 {
    color: #666;
    margin-bottom: 15px;
}

.card h2 {
    font-size: 32px;
}

.student-section,
.attendance-section {
    background: white;
    margin-top: 30px;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
}

.student-section h2,
.attendance-section h2 {
    margin-bottom: 20px;
}

input {
    padding: 12px;
    margin-right: 10px;
    border: 1px solid #ddd;
    border-radius: 8px;
}

button {
    padding: 12px 18px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    background: #222;
    color: white;
}

.student-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px;
    border-bottom: 1px solid #eee;
}

.present-btn {
    background: #198754;
    margin-right: 8px;
}

.absent-btn {
    background: #dc3545;
}

@media (max-width: 800px) {
    .cards {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 500px) {
    .cards {
        grid-template-columns: 1fr;
    }

    input {
        width: 100%;
        margin-bottom: 10px;
    }
}
